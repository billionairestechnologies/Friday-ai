{
  "name": "friday-x",
  "displayName": "FridayX",
  "description": "Friday's coding agent in your editor. Uses your Friday account, plan, models and usage meter.",
  "version": "0.1.0",
  "publisher": "billionaires-technologies",
  "license": "Apache-2.0",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["AI", "Programming Languages", "Other"],
  "keywords": ["friday", "ai", "coding agent", "assistant"],
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "fridayX.open", "title": "FridayX: Open", "icon": "$(sparkle)" },
      { "command": "fridayX.sendSelection", "title": "FridayX: Send Selection to FridayX" },
      { "command": "fridayX.sendFile", "title": "FridayX: Send Current File to FridayX" },
      { "command": "fridayX.login", "title": "FridayX: Sign In" },
      { "command": "fridayX.logout", "title": "FridayX: Sign Out" },
      { "command": "fridayX.install", "title": "FridayX: Install or Update" }
    ],
    "keybindings": [
      { "command": "fridayX.open", "key": "ctrl+alt+f", "mac": "cmd+alt+f" },
      { "command": "fridayX.sendSelection", "key": "ctrl+alt+k", "mac": "cmd+alt+k", "when": "editorHasSelection" }
    ],
    "menus": {
      "editor/title": [{ "command": "fridayX.open", "group": "navigation" }],
      "editor/context": [{ "command": "fridayX.sendSelection", "when": "editorHasSelection", "group": "friday" }]
    },
    "configuration": {
      "title": "FridayX",
      "properties": {
        "fridayX.serverUrl": {
          "type": "string",
          "default": "https://friday.billionairestechnologies.com",
          "description": "The Friday server FridayX signs in to and installs from. Leave the default unless you run your own deployment."
        },
        "fridayX.executable": {
          "type": "string",
          "default": "friday",
          "description": "Path to the friday executable (default: the one on your PATH, or ~/.friday/bin)."
        },
        "fridayX.openInEditorArea": {
          "type": "boolean",
          "default": true,
          "description": "Open the FridayX terminal beside your editor instead of in the bottom panel."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
