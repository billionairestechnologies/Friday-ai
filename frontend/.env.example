# Leave blank in dev — Vite proxies /api to the backend (see vite.config.ts).
# Set this to your deployed backend URL in production.
VITE_API_BASE_URL=

# Used for direct-to-Supabase Realtime subscriptions (live cross-device chat sync), bypassing the
# backend for that one thing. Safe to expose client-side — this is the anon/publishable key, and
# every table it can read is RLS-scoped to auth.uid(). Same project as the backend's SUPABASE_URL.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
