flowchart TB
  subgraph clients [Clients]
    Browser[Web app - React Vite]
    Android[Android - Kotlin Compose]
    IOS[iOS - SwiftUI]
    Console[Team Console /admin - staff RBAC]
    Public[Public pages - /status /plans /share /p pages]
    FX[FridayX - terminal CLI, VS Code, JetBrains, Zed]
  end

  subgraph api [Friday API - Express TypeScript]
    MW[Helmet CORS request ID rate limits quota pre-flight]
    AuthR["/api/auth"]
    ChatR["/api/chat SSE + search + share"]
    Agent[Agent tool loop - native tool calling + usage meter]
    Tools[Tools: web, run_code, create_document, use_skill, connectors, MCP, memory]
    BuildR["/api/build - Build Mode coding agent"]
    AutoR["/api/automations + scheduler"]
    LibR["/api/library + /api/files"]
    SkillR["/api/skills"]
    StatusR["/api/status - probes, incidents, reports, crashes"]
    ConsoleR["/api/console - support CRM tasks updates campaigns plans status"]
    Engage["/api/updates /api/support /api/offers /api/email"]
    BillR["/api/billing - catalog + packages"]
    ConnR["/api/connectors /api/mcp /api/memory"]
    OrgR["/api/organizations /usage /projects /voice"]
    PagesR["/api/pages - live docs, sheets, slides"]
    XR["/api/x - FridayX device login, models, metered gateway"]
    InstR["/x - installers, version, checksums"]
    FinR["Console: Finance (cost vs sell, P&L, profit controls) + Mailbox (mail hosting)"]
  end

  subgraph core [Shared services]
    Quota[Credit meter - priced per call, reserve, charge per round, reconcile, runaway guard]
    Ent[Entitlements - plan <- catalog <- org <- package]
    Docs[Document renderers - pptx xlsx docx pdf text]
    Sched[Schedulers - automations, campaigns, grant expiry, status probes]
    Jobs[Turn jobs - turns outlive the app, resume after deploy]
    Know[Project knowledge - embeddings + hybrid search]
    Browse[Browser agent - Playwright in an E2B sandbox]
  end

  subgraph data [Data plane]
    SB[(Supabase Postgres + Auth + Realtime)]
    Store[Supabase Storage - attachments + generated files]
    Redis[(Redis - quota counters, allowances, model health, leases)]
  end

  subgraph vendors [External services]
    Models[OpenAI Anthropic Gemini OpenRouter ScaleMax Sarvam Ollama]
    E2B[E2B sandboxes - code + builds]
    Web[Web search + page fetch - SSRF guarded]
    Apps[GitHub Google Notion Vercel Railway Supabase Razorpay + user MCP]
    Pay[Razorpay checkout + webhook]
    Mail[Resend - OTP, support, campaigns, alerts]
    Mailcow[Mailcow - company domains and mailboxes]
    Releases[(Release bucket + CDN - FridayX binaries)]
  end

  Browser & Android & IOS --> MW
  FX --> XR
  FX -. one-line install .-> InstR
  XR --> Quota & Ent & Models
  XR --> SB
  InstR --> Releases
  PagesR --> SB
  FinR --> SB
  FinR --> Mailcow
  Agent --> Jobs & Know & Browse
  Browse --> E2B
  Console --> ConsoleR
  Public --> StatusR & BillR & ChatR
  MW --> AuthR & ChatR & BuildR & AutoR & LibR & SkillR & Engage & BillR & ConnR & OrgR & PagesR
  ChatR --> Agent --> Tools
  BuildR --> Tools
  Tools --> Models & Web & E2B & Apps & Docs
  Agent --> Quota
  BuildR --> Quota
  Quota --> Ent
  ChatR --> Ent
  BillR --> Ent
  AutoR --> ChatR
  Docs --> Store
  LibR --> SB & Store
  ConsoleR --> SB
  ConsoleR --> Mail
  StatusR --> Mail
  Engage --> SB & Mail
  BillR --> Pay
  AuthR --> SB & Mail
  Sched --> SB & Mail & Models
  Quota --> Redis
  ChatR --> SB
