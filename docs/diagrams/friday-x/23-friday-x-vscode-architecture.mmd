flowchart LR
  subgraph VS["VS Code window"]
    direction TB
    WV["Chat panel (webview)<br/>main.js + fx.js orbs and mascots"]
    EXT["Extension host (TypeScript)<br/>controller, auth, binary, acp"]
    ED["Editor<br/>diff review, reveal edits, open file"]
    KC[("OS keychain<br/>SecretStorage: fxt_ token")]
