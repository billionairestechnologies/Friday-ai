flowchart TB
  Guest[Visitor] --> SignIn{Sign in}
  SignIn --> Email[Email + OTP]
  SignIn --> Google[Google]
  SignIn --> SSO[Company SSO]
  Email --> User[Signed-in user]
  Google --> User
  SSO --> User

  User --> Chat[Chat with Friday]
  User --> Files[Attach files]
  User --> Tools[Toggle Search Think Canvas]
  User --> Voice[Voice mode]
  User --> Projects[Create Work or Developer project]
  User --> Plugins[Connect GitHub Google Notion etc]
  User --> Settings[Settings]
  User --> Team[Team org invite budget]
  User --> Pay[Pay Pro or Business via Razorpay]
  User --> Data[Download or delete my data]
  User --> Usage[See usage - percent used and reset time]
  User --> FX[Use FridayX in the terminal or an editor]
  FX --> Install[One-line install, then friday login in the browser]
  Settings --> Devices[Settings - FridayX - signed-in devices, sign out]

  Settings --> Account[Account profile]
  Settings --> Appearance[Appearance]
  Settings --> VoiceSet[Voice picker]
  Settings --> Billing[Billing]
  Settings --> Data
  Settings --> Team
  Settings --> Usage
