sequenceDiagram
  actor U as User
  participant FE as Login dialog
  participant API as /api/auth
  participant Mail as Resend
  participant G as Google
  participant DB as Supabase Auth

  alt Email and password
    U->>FE: Email + password
    FE->>API: POST /login
    API->>DB: Check password
    API->>Mail: Send 6-digit OTP
    U->>FE: Enter OTP
    FE->>API: POST /verify-otp
    API-->>FE: Session JWT
  else Google
    U->>FE: Continue with Google
    FE->>API: GET /auth/google/start
    API->>G: OAuth consent
    G-->>API: Code
    API->>DB: Create or reuse user
    API-->>FE: Hash friday_session
    FE->>FE: Store JWT locally
  else Company SSO
    U->>FE: Continue with Company SSO
    FE->>SSO: SSO_ENTRY_URL
  end
