# Server
NODE_ENV=development
PORT=4000
# Comma-separated browser origins. Server-to-server requests without Origin are allowed.
CORS_ORIGIN=http://localhost:5173
# Set to the trusted proxy hop count in production (commonly 1). Required for accurate client IP limits.
TRUST_PROXY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Secret used to encrypt provider API keys before storing them in the database
KEY_ENCRYPTION_SECRET=change-me-to-a-32-byte-random-string

# Per-process safety limits. Set REDIS_URL to share limits across instances.
AUTH_RATE_LIMIT_MAX=10
OTP_RATE_LIMIT_MAX=5
CHAT_RATE_LIMIT_MAX=20
CHAT_DAILY_LIMIT_MAX=100
CHAT_CONCURRENCY_MAX=2
VOICE_RATE_LIMIT_MAX=30
VOICE_CONCURRENCY_MAX=2
SANDBOX_RATE_LIMIT_MAX=5
SANDBOX_CONCURRENCY_MAX=1

# Optional Redis URL for distributed rate/concurrency limits across API instances.
REDIS_URL=

# Public URLs used for OAuth redirects and SSO entry.
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# Store large attachments in Supabase Storage (bucket: message-attachments). Set false to keep inline data URLs.
ATTACHMENT_OBJECT_STORAGE=true

# Google OAuth (kept here for when the locked Google sign-in button is enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub connector OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/api/connectors/github/callback

# Enterprise SSO entry (configure the IdP in Supabase Auth; this surfaces the button and deep-link)
SSO_ENABLED=false
SSO_ENTRY_URL=
SSO_PROVIDER_LABEL=Company SSO

# TinyFish Search API (https://docs.tinyfish.ai/search-api) — powers the composer's "Search" toggle.
# Free tier, no key required to fall back to DuckDuckGo instant answers if unset.
TINYFISH_API_KEY=

# Resend (https://resend.com) — sends the login OTP email. Without a verified sending domain,
# Resend's sandbox sender can only deliver to the email address on the Resend account itself.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Friday <onboarding@resend.dev>

# E2B code sandbox
E2B_API_KEY=

# Razorpay billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
