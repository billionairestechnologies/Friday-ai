# Copy to infra/aws/app.env (git-ignored), fill in, then: infra/aws/deploy.sh --env-file infra/aws/app.env
# Stored as ONE Secrets Manager secret (<stack>/app-env) and read by the API as FRIDAY_ENV_JSON.
# NODE_ENV, PORT, TRUST_PROXY and REDIS_URL are set by the stack — don't put them here.

# Supabase (required)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Web app build (defaults to the two values above when empty)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Security (required: 32+ random bytes, e.g. `openssl rand -base64 48`; keep the SAME value as the old
# server or stored connector/API keys can't be decrypted)
KEY_ENCRYPTION_SECRET=

# Your public URLs (the ALB DNS name or your domain, no trailing slash)
PUBLIC_APP_URL=
PUBLIC_API_URL=
SITE_URL=
CORS_ORIGIN=

# Email (required for OTP login, support, campaigns, alerts)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
STATUS_ALERT_EMAILS=
SUPPORT_INBOUND_SECRET=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Login + connectors
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Build Mode / run_code, web search, push, voice
E2B_API_KEY=
TINYFISH_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
FCM_SERVICE_ACCOUNT_JSON=

# Mobile update check (optional)
FRIDAY_LATEST_VERSION_ANDROID=
FRIDAY_DOWNLOAD_ANDROID=
